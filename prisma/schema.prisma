generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Application profile, keyed to the Supabase Auth user id.
/// Credentials and sessions are owned by Supabase Auth (auth.users),
/// so there is no password column here and no Session table.
model User {
  id        String   @id @db.Uuid // must match auth.users.id
  email     String   @unique
  name      String?
  phone     String?
  avatar    String   @default("🐾")
  role      String   @default("buyer") // "admin" | "buyer"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Design {
  id           String   @id @default(cuid())
  brand        String?
  title        String
  description  String?
  imageUrl     String
  gallery      Json?
  category     String // "dog" | "cat"
  garmentType  String // "hoodie" | "sweater" | "raincoat" | "bandana" | ...
  sizes        Json
  colors       Json
  price        Float
  mrp          Float?
  fabric       String?
  care         String?
  highlights   Json?
  measurements Json?
  rating       Float    @default(0)
  ratingCount  Int      @default(0)
  // Soft delete keeps OrderItem foreign keys intact once a design is sold.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems OrderItem[]

  @@index([isActive])
  @@index([category])
}

model Order {
  id                String      @id @default(cuid())
  userId            String      @db.Uuid
  stripeSessionId   String?     @unique
  status            String      @default("placed")
  // placed | confirmed | packed | shipped | out_for_delivery | delivered | cancelled
  subtotal          Float       @default(0)
  shipping          Float       @default(0)
  tax               Float       @default(0)
  discount          Float       @default(0)
  total             Float       @default(0)
  paymentMethod     String?
  trackingNumber    String?
  shippingAddress   Json?
  estimatedDelivery DateTime?
  timeline          Json        @default("[]")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  designId String
  // Snapshot of the product at purchase time, so editing or removing a
  // listing later never rewrites the customer's order history.
  name     String
  brand    String?
  image    String?
  mrp      Float?
  size     String
  color    String
  quantity Int    @default(1)
  price    Float

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  design Design @relation(fields: [designId], references: [id])

  @@index([orderId])
  @@index([designId])
}