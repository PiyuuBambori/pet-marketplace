# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/pet_marketplace?schema=public"

# Canonical site URL — used for metadata, sitemap.xml and Stripe redirects
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_xxx"
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or the dashboard
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Session signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Permanent admin account (optional overrides)
ADMIN_EMAIL="admin@doom.shop"
ADMIN_PASSWORD="admin123"