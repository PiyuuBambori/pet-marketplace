# Supabase project
# Project URL and keys: Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Safe to expose to the browser. This is the anon/publishable key and is used
# by the sign-in, sign-up and sign-out helpers only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Server-only. Bypasses row level security, so it must NEVER be prefixed with
# NEXT_PUBLIC_ and must never be imported into a Client Component.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PostgreSQL connection string.
# Local / one-off migrations: the direct connection from Project Settings -> Database.
# Production (Vercel): use the Supavisor pooler for your region and append
#   ?pgbouncer=true&connection_limit=1
# Serverless needs the pooler — a direct connection will exhaust connections.
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?schema=public"

# Canonical site URL — used for metadata, sitemap.xml and Stripe redirects
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_xxx"
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or the dashboard
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Seeded admin account. Supabase Auth owns the password; this is only used by
# `npx prisma db seed`. Change it after the first login.
ADMIN_EMAIL="admin@doom.shop"
ADMIN_PASSWORD="replace-with-a-strong-password"